# ==============================================================================
# AURELIA — Haute Cuisine & Reservation Platform Environment Configuration
# ==============================================================================
# NOTE: All secrets listed here are SERVER-SIDE ONLY.
# NEVER commit your actual .env file with production credentials to source control.
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB & Mongoose)
# Provide your MongoDB Atlas or local MongoDB connection URI.
# If omitted during local development, an embedded persistent MongoDB instance is automatically provisioned.
MONGODB_URI="mongodb://127.0.0.1:27017/aurelia_restaurant"

# Session & Security
# Used for signing secure, HTTP-only administrator session cookies.
SESSION_SECRET="your-strong-random-session-secret-key-min-32-characters"

# Administrative Initial Bootstrap Credentials (AUTH ONLY — login identity)
# ADMIN_AUTH_EMAIL (if set) takes precedence over ADMIN_EMAIL for the seeded
# admin login account. Keep this separate from CONTACT_NOTIFICATION_EMAIL.
ADMIN_AUTH_EMAIL="admin@aurelia.com"
ADMIN_EMAIL="admin@aurelia.com"
ADMIN_PASSWORD="AureliaAdmin2026!"
# Contact-form notification recipient (the real inbox that receives guest
# inquiries). May be any mailbox including Gmail — it is only a RECIPIENT.
# Must NOT be confused with EMAIL_FROM, which Resend requires to be a
# verified custom domain (gmail.com is rejected as a SENDER).

# Cloudinary Media Storage (Mandatory for Image Life Cycle)
# Media uploaded via the Admin Portal will be stored, transformed, and managed on Cloudinary.
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Transactional Email Provider (Resend HTTP API)
# Used to dispatch public contact form inquiries to ADMIN_EMAIL.
# Resend requires the sender domain in EMAIL_FROM to be verified at
# https://resend.com/domains — free mailbox providers such as gmail.com
# CANNOT be used as senders and return: 403 validation_error
# "The gmail.com domain is not verified."
# Configure a verified custom domain, e.g.:
#   EMAIL_FROM="Aurelia Concierge <concierge@your-verified-domain.com>"
EMAIL_API_KEY="re_your_resend_or_transactional_email_api_key"
EMAIL_FROM="Aurelia Concierge <concierge@aurelia-dining.com>"
